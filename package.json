{
  "name": "teenieping-dogam",
  "version": "0.1.0",
  "private": true,
  "description": "비공식·비영리 '캐치! 티니핑' 팬 도감 (React + Vite, Node 수집/빌드 파이프라인)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:data && vite build && node tools/prerender.mjs",
    "preview": "vite preview",
    "fetch": "node tools/fetch-fandom.mjs",
    "fetch:namu": "node tools/fetch-namu.mjs",
    "images": "node tools/fetch-images.mjs && node tools/process-images.mjs",
    "build:data": "node tools/build-data.mjs",
    "update": "npm run fetch && npm run fetch:namu && npm run images && npm run build",
    "test": "node --test \"tools/test/*.test.mjs\""
  },
  "optionalDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "sharp": "^0.34.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  }
}
